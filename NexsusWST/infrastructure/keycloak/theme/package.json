{
  "name": "nexuswst-keycloak-theme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build-keycloak-theme": "npm run build && npx --no-install keycloakify build"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "keycloakify": "11.16.4",
    "lucide-react": "1.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "6.4.5"
  }
}
