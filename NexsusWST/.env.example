# =============================================================================
#  NexusWST - Variables de entorno
#  1) Copia este archivo:  cp .env.example .env   (Windows: copy .env.example .env)
#  2) Cambia los valores marcados con CAMBIAR.
#  3) NUNCA subas .env a GitLab (ya está en .gitignore). Aquí solo hay valores
#     ficticios (DAS §7.3: .env.example sin credenciales reales).
# =============================================================================

# --- General ------------------------------------------------------------------
APP_ENV=development
APP_DOMAIN=localhost
TZ=America/Santiago
LOG_LEVEL=debug

# Puertos en tu equipo (cámbialos si ya los usas)
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
TRAEFIK_DASHBOARD_PORT=8088
ADMINER_PORT=8089

# --- PostgreSQL -----------------------------------------------------------------
POSTGRES_DB=nexuswst
POSTGRES_USER=nexus
POSTGRES_PASSWORD=CAMBIAR_password_local_123
POSTGRES_SSLMODE=disable

# --- Redis ----------------------------------------------------------------------
REDIS_PASSWORD=CAMBIAR_redis_local_123
# TTL por defecto de catálogos cacheados (RF-29/31). Se ajusta en PV-13.
CACHE_DEFAULT_TTL=12h

# --- URL pública de la aplicación ---------------------------------------------
# Lo que escribe el usuario en el navegador. En producción: https://<dominio>
APP_PUBLIC_URL=http://localhost

# --- Keycloak: proveedor de identidad (DAS v1.1, DA-15, PV-18) ---------------
# Token de 10 min, sesión de 12 h y cierre tras 2 h sin uso: están en el realm
# (infrastructure/keycloak/import/nexuswst-realm.json).
KEYCLOAK_VERSION=26.8.1
# URL pública de Keycloak (define el "iss" del token). Dev: misma URL + /auth.
# Producción (DAS): https://auth.westorage.cl/auth  y  AUTH_DOMAIN=auth.westorage.cl
KEYCLOAK_PUBLIC_URL=http://localhost/auth
AUTH_DOMAIN=localhost
# Usuario de la consola de Keycloak (http://localhost/auth/admin), solo emergencias
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=CAMBIAR_admin_keycloak_123
# Usuario propio de Keycloak en PostgreSQL (esquema "keycloak")
KEYCLOAK_DB_PASSWORD=CAMBIAR_db_keycloak_123
# Secreto de la cuenta de servicio nexus-core (Admin API). Genera uno largo:
#   openssl rand -hex 32
KEYCLOAK_CORE_CLIENT_SECRET=CAMBIAR_secreto_nexus_core
# true SOLO en desarrollo: permite pedir tokens con usuario/contraseña desde
# Postman o curl. En producción queda en false (solo login con PKCE).
KC_WEB_DIRECT_GRANTS=true

# --- Correo (Keycloak envía los correos de acceso) ---------------------------
# Desarrollo: Mailpit (bandeja en http://127.0.0.1:8025). Producción: el SMTP
# de WeStorage con remitente no-reply@westorage.cl (lo configura TI / Ismael).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@westorage.cl
SMTP_AUTH=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
MAILPIT_PORT=8025

# --- Órdenes / trabajos asíncronos (Redis Streams, PA-06) -----------------------
ORDERS_STREAM=nexus:jobs:orders
ORDERS_CONSUMER_GROUP=orders-workers
WORKER_CONCURRENCY=2

# --- Integraciones externas (vacías = adaptador simulado) -----------------------
INVAS_BASE_URL=
INVAS_API_KEY=
# true = el Invas simulado no responde (para probar reintentos e Incidencia)
WMS_SIMULATE_DOWN=false
# Segundos que tarda el Invas simulado en dejar una orden «Preparada»
WMS_SIM_PICK_SECONDS=60
# Clave AES-256 (64 caracteres hex) para cifrar los secretos de integraciones
# por cliente (webhooks). Genera una:  openssl rand -hex 32
INTEGRATIONS_KEY=CAMBIAR_64_caracteres_hex_openssl_rand_hex_32
